  "gated_ingestion_specs": [
    {
      "id": "paid_rx_claims",
      "category": "claims_rx_demand",
      "status": "requires_license_or_client_data",
      "example_sources": ["IQVIA", "Symphony", "Komodo", "Optum", "MarketScan"],
      "ci_use": "Near-real-time demand, starts, switches, persistence, channel mix, payer segment, diagnosis linkage, and cash/commercial/Medicare Advantage behavior.",
      "required_fields": ["fill_date", "product_or_ndc", "quantity", "days_supply", "payer_type", "plan_or_channel", "patient_id_hash", "diagnosis_code_optional", "geography_optional"],
      "minimum_refresh_cadence": "monthly"
    },
    {
      "id": "commercial_pbm_policy",
      "category": "formulary_access",
      "status": "requires_license_or_manual_policy_corpus",
      "example_sources": ["MMIT", "FormularyLookup", "Fingertip", "PBM policy PDFs", "payer medical/pharmacy policies"],
      "ci_use": "Commercial coverage, PA criteria, BMI/comorbidity rules, continuation criteria, exclusions, step therapy, and channel-specific access barriers.",
      "required_fields": ["payer", "plan", "product", "coverage_status", "tier_optional", "pa_required", "step_required", "quantity_limit", "policy_effective_date", "source_url_or_file"],
      "minimum_refresh_cadence": "monthly"
    },
